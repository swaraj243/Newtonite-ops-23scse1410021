generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkItemType {
  INCIDENT
  CUSTOMER_ISSUE
  PAYMENT
  COMPLIANCE
  TASK
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships       Membership[]
  assignedWorkItems WorkItem[]       @relation("WorkItemAssignee")
  createdWorkItems  WorkItem[]       @relation("WorkItemCreator")
  activityEvents    ActivityEvent[]
  comments          Comment[]
  idempotencyKeys   IdempotencyKey[]
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  workItems   WorkItem[]
}

model Membership {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @db.Uuid
  teamId String         @db.Uuid
  role   MembershipRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model WorkItem {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String           @db.Text
  type        WorkItemType
  priority    WorkItemPriority
  status      WorkItemStatus
  teamId      String           @db.Uuid
  assigneeId  String?          @db.Uuid
  createdById String           @db.Uuid
  dueDate     DateTime?
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  team     Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee User?           @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User           @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activityEvents ActivityEvent[]
  comments       Comment[]

  @@index([teamId, status])
  @@index([assigneeId, status])
  @@index([priority, status])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model ActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  workItemId String   @db.Uuid
  actorId    String   @db.Uuid
  eventType  String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt])
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  workItemId String   @db.Uuid
  authorId   String   @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt])
}

model IdempotencyKey {
  key          String   @id
  userId       String   @db.Uuid
  endpoint     String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OutboxJob {
  id          String          @id @default(uuid()) @db.Uuid
  eventType   String
  payload     Json
  status      OutboxJobStatus @default(PENDING)
  attempts    Int             @default(0)
  maxAttempts Int             @default(3)
  lastError   String?
  nextRunAt   DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, nextRunAt])
}
