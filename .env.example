# PostgreSQL (docker-compose)
POSTGRES_USER=newtonite
POSTGRES_PASSWORD=newtonite_dev_password
POSTGRES_DB=newtonite_ops

# Backend database URL (used by Prisma)
DATABASE_URL=postgresql://newtonite:newtonite_dev_password@localhost:5432/newtonite_ops?schema=public

# Optional: JWT / session secrets (set in .env for local dev)
# JWT_SECRET=change-me-in-production
# SESSION_SECRET=change-me-in-production
